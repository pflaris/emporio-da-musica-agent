# Copie este arquivo para ".env" e preencha a chave.
# Chave gratuita do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: modelo principal (padrão: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Opcional: modelos de reserva, usados se o principal não existir para a sua chave
# (padrão: gemini-3.5-flash-lite,gemini-2.5-flash)
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash

# Opcional: simula a data/hora "de agora" (fuso de Campo Grande).
# Os dados de exemplo são um retrato de fev/mar de 2026; use isto para testar
# prazos de devolução e horário de funcionamento de forma reproduzível.
# EMPORIO_NOW=2026-03-23 10:30
